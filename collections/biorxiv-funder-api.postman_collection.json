          "id": "7f93770d-0904-4b75-ba88-78b96be44a81",
          "name": "Get funder-filtered content",
          "request": {
            "name": "Get funder-filtered content",
            "description": {
              "content": "Returns metadata for up to 100 preprints from bioRxiv or medRxiv funded by a specific organization identified by their ROR ID within a given date range. Data availability starts from 2025-04-10.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "funder",
                ":server",
                ":interval",
                ":funderRorId",
                ":cursor",
                ":format"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "Optional subject category filter"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "server",
                  "description": "(Required) Preprint server to query"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "interval",
                  "description": "(Required) Date range (YYYY-MM-DD/YYYY-MM-DD, earliest 2025-04-10), numeric, or numeric+d\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "funderRorId",
                  "description": "(Required) 9-character ROR identifier for the funding organization"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "0",
                  "key": "cursor",
                  "description": "(Required) Pagination cursor (0-based start position)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "json",
                  "key": "format",
                  "description": "(Required) Response format"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
