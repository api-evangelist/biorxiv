          "id": "89f2e316-010c-43ae-8d21-b2220980f519",
          "name": "Get preprint content details by date interval",
          "request": {
            "name": "Get preprint content details by date interval",
            "description": {
              "content": "Returns metadata for up to 30 preprints from bioRxiv or medRxiv within a specified date range or recent N papers. Supports optional subject category filtering.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "details",
                ":server",
                ":interval",
                ":cursor",
                ":format"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "Optional subject category filter (URL-encoded or underscore-separated)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "server",
                  "description": "(Required) Preprint server to query"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "interval",
                  "description": "(Required) Date range (YYYY-MM-DD/YYYY-MM-DD), numeric count of recent papers (e.g. 30), or N days ago (e.g. 7d)\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "0",
                  "key": "cursor",
                  "description": "(Required) Pagination cursor (0-based start position)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "json",
                  "key": "format",
                  "description": "(Required) Response format"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
