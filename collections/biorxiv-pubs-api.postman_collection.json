                  "key": "format",
                  "value": "json",
                  "description": "Response format"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "server",
                  "description": "(Required) Preprint server to query"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "interval",
                  "description": "(Required) Date range (YYYY-MM-DD/YYYY-MM-DD), numeric, or numeric+d"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "0",
                  "key": "cursor",
                  "description": "(Required) Pagination cursor (0-based start position)"
